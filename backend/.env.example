# ========================================
# NutriGuard AI — Environment Variables
# ========================================

# Database
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/nutriguard

# Groq AI
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# JWT Authentication
JWT_SECRET=CHANGE_THIS_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
STORAGE_PATH=./storage

# Environment
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Keep API documentation private for the hackathon demo. Set true only locally.
ENABLE_API_DOCS=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://10.0.2.2:8000

# Rate Limiting
RATE_LIMIT=100/minute

# Max Upload Size (bytes) — 10 MB
MAX_UPLOAD_SIZE=10485760
